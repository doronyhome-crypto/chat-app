* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: system-ui, "Segoe UI", Arial, sans-serif;
  background: #f0f2f5;
  color: #1c1e21;
  min-height: 100vh;
}

[hidden] {
  display: none !important;
}

button {
  font: inherit;
  cursor: pointer;
}

input {
  font: inherit;
  padding: 10px 12px;
  border: 1px solid #ccd0d5;
  border-radius: 8px;
  min-width: 0;
}

.muted {
  font-size: 0.8rem;
  color: #65676b;
}

.error {
  margin: 0;
  min-height: 1em;
  color: #cf222e;
  font-size: 0.85rem;
}

.link {
  background: none;
  border: none;
  color: #0084ff;
  padding: 4px;
}

.link.small {
  font-size: 0.75rem;
}

/* ---------- התחברות ---------- */
.auth {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.auth-card {
  width: 100%;
  max-width: 360px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: #fff;
  padding: 24px;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
}

.auth-card h1 {
  margin: 0 0 4px;
  font-size: 1.4rem;
  text-align: center;
}

.auth-card button[type="submit"] {
  padding: 10px;
  border: none;
  border-radius: 8px;
  background: #0084ff;
  color: #fff;
}

.auth-card button[type="submit"]:hover {
  background: #006fd6;
}

/* ---------- מבנה ראשי ---------- */
.app {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

.sidebar {
  width: 280px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-inline-end: 1px solid #e4e6eb;
}

.sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid #e4e6eb;
}

.sidebar-header div {
  display: flex;
  flex-direction: column;
}

.chat-list {
  flex: 1;
  overflow-y: auto;
  list-style: none;
  margin: 0;
  padding: 8px;
}

.chat-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px;
  border-radius: 8px;
  cursor: pointer;
}

.chat-item:hover {
  background: #f0f2f5;
}

.chat-item.active {
  background: #e7f3ff;
}

.chat-item-info {
  flex: 1;
  min-width: 0;
}

.chat-item-name {
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  min-width: 22px;
  padding: 2px 7px;
  border-radius: 999px;
  background: #0084ff;
  color: #fff;
  font-size: 0.75rem;
  text-align: center;
}

.add-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 12px;
  border-top: 1px solid #e4e6eb;
}

.add-contact input {
  flex: 1;
}

.add-contact button {
  padding: 10px 14px;
  border: none;
  border-radius: 8px;
  background: #0084ff;
  color: #fff;
}

.add-contact .error {
  flex: 1 1 100%;
}

/* ---------- צ'אט ---------- */
.chat {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  background: #fff;
}

.chat-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  border-bottom: 1px solid #e4e6eb;
}

.chat-header h1 {
  flex: 1;
  margin: 0;
  font-size: 1.25rem;
}

.menu-btn {
  display: none;
  background: none;
  border: none;
  font-size: 1.4rem;
  padding: 0 4px;
}

.status {
  font-size: 0.85rem;
  color: #65676b;
}

.status.online {
  color: #1a7f37;
}

.status.offline {
  color: #cf222e;
}

.messages {
  flex: 1;
  overflow-y: auto;
  list-style: none;
  margin: 0;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.message {
  max-width: 80%;
  padding: 8px 12px;
  border-radius: 12px;
  background: #e4e6eb;
  align-self: flex-start;
}

.message.mine {
  background: #0084ff;
  color: #fff;
  align-self: flex-end;
}

.message-meta {
  font-size: 0.75rem;
  opacity: 0.7;
  margin-bottom: 2px;
}

.message-text {
  white-space: pre-wrap;
  overflow-wrap: break-word;
}

.composer {
  display: flex;
  gap: 8px;
  padding: 12px;
  border-top: 1px solid #e4e6eb;
}

.composer input {
  flex: 1;
}

.composer button {
  padding: 10px 16px;
  border: none;
  border-radius: 8px;
  background: #0084ff;
  color: #fff;
}

.composer button:hover {
  background: #006fd6;
}

/* ---------- מובייל: הסרגל נפתח מתפריט ---------- */
@media (max-width: 720px) {
  .menu-btn {
    display: block;
  }

  .sidebar {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: 10;
    transform: translateX(100%);
    transition: transform 0.2s ease;
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.2);
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .app {
    flex-direction: column;
  }
}
